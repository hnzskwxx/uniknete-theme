<style>
.un-footer {
  padding: 48px 48px;
  background: #0D110D;
  border-top: 1px solid rgba(240,237,232,0.12);
  position: relative;
  z-index: 1;
}
.un-footer-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: space-between;
  align-items: center;
  flex-wrap: wrap;
  gap: 20px;
}
.un-footer-logo {
  font-family: 'Syne', sans-serif;
  font-size: 17px;
  font-weight: 800;
  color: var(--white);
  letter-spacing: 2px;
  text-transform: uppercase;
  text-decoration: none;
}
.un-footer-logo span { color: var(--accent); }

.un-footer-links {
  display: flex;
  gap: 32px;
  flex-wrap: wrap;
  align-items: center;
}
.un-footer-links a {
  font-size: 11px;
  color: var(--white-30);
  text-decoration: none;
  letter-spacing: 0.5px;
  transition: color 0.2s;
}
.un-footer-links a:hover { color: var(--accent); }

.un-footer-copy {
  font-size: 11px;
  color: var(--white-30);
  letter-spacing: 0.5px;
}

@media (max-width: 768px) {
  .un-footer { padding: 36px 24px; }
  .un-footer-inner { flex-direction: column; align-items: flex-start; gap: 24px; }
  .un-footer-links { gap: 20px; }
}
</style>

<footer class="un-footer">
  <div class="un-footer-inner">
    <a href="/" class="un-footer-logo">Unikněte<span>!</span></a>
    <div class="un-footer-links">
      <a href="/pages/kontakt">Kontakt</a>
      <a href="mailto:uniknete@gmail.com">uniknete@gmail.com</a>
      <a href="tel:+420728984126">+420 728 984 126</a>
      <a href="/pages/ochrana">Ochrana dat</a>
      <a href="/pages/reklamace">Reklamace</a>
    </div>
    <div class="un-footer-copy">© {{ 'now' | date: '%Y' }} Unikněte!</div>
  </div>
</footer>

{% schema %}
{ "name": "Footer", "settings": [] }
{% endschema %}
