<style>
.un-how {
  padding: 100px 48px;
  background: rgba(8,11,8,0.92);
  border-top: 1px solid rgba(240,235,224,0.08);
}
.un-how-inner {
  max-width: 1100px;
  margin: 0 auto;
}
.un-how-header {
  margin-bottom: 72px;
}
.un-how-steps {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(240,235,224,0.08);
}
.un-how-step {
  background: rgba(8,11,8,0.92);
  padding: 52px 40px 48px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  overflow: hidden;
  transition: background 0.25s;
}
.un-how-step:hover {
  background: rgba(212,168,71,0.04);
}

/* Ghost číslo na pozadí */
.un-how-step-ghost {
  position: absolute;
  top: -8px;
  right: 20px;
  font-family: 'Playfair Display', serif;
  font-size: 120px;
  font-weight: 900;
  color: rgba(212,168,71,0.06);
  line-height: 1;
  pointer-events: none;
  user-select: none;
  letter-spacing: -4px;
}

/* Malé číslo */
.un-how-step-num {
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 3px;
  text-transform: uppercase;
  color: var(--accent);
  display: flex;
  align-items: center;
  gap: 10px;
}
.un-how-step-num::after {
  content: '';
  display: block;
  width: 24px;
  height: 1px;
  background: var(--accent);
  opacity: 0.5;
}

.un-how-step-title {
  font-family: 'Playfair Display', serif;
  font-size: 24px;
  font-weight: 700;
  color: var(--white);
  line-height: 1.2;
}
.un-how-step-desc {
  font-size: 14px;
  color: var(--white-60);
  line-height: 1.75;
  font-weight: 300;
}

.un-how-cta {
  margin-top: 64px;
  display: flex;
  justify-content: center;
}

@media (max-width: 768px) {
  .un-how { padding: 64px 24px; }
  .un-how-steps {
    grid-template-columns: 1fr;
  }
  .un-how-step { padding: 40px 28px; }
  .un-how-step-ghost { font-size: 80px; }
  .un-how-cta { margin-top: 48px; }
}
</style>

<section class="un-how" id="jak">
  <div class="un-how-inner">
    <div class="un-how-header">
      <span class="section-label">Jednoduché</span>
      <h2 class="section-title">{{ section.settings.title }}</h2>
    </div>

    <div class="un-how-steps">
      {% for block in section.blocks %}
        <div class="un-how-step" {{ block.shopify_attributes }}>
          <span class="un-how-step-ghost">0{{ forloop.index }}</span>
          <div class="un-how-step-num">Krok 0{{ forloop.index }}</div>
          <div class="un-how-step-title">{{ block.settings.title }}</div>
          {% if block.settings.desc != blank %}
            <p class="un-how-step-desc">{{ block.settings.desc }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>

    <div class="un-how-cta">
      <a href="/pages/hry" class="btn-primary">Vybrat hru →</a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Jak to funguje",
  "settings": [
    { "type": "text", "id": "title", "label": "Nadpis", "default": "Jak to funguje" }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Krok",
      "settings": [
        { "type": "text", "id": "title", "label": "Název" },
        { "type": "textarea", "id": "desc", "label": "Popis" }
      ]
    }
  ],
  "presets": [{
    "name": "Jak to funguje",
    "blocks": [
      { "type": "step", "settings": { "title": "Koupíš hru", "desc": "Vyber hru, zaplať online. Hotovo za 2 minuty." } },
      { "type": "step", "settings": { "title": "Dostaneš instrukce", "desc": "Na mail přijde PDF s QR kódem a vším co potřebuješ." } },
      { "type": "step", "settings": { "title": "Hraješ", "desc": "Vyraz ven. Řeš šifry, hledej stopy, dokončete příběh." } }
    ]
  }]
}
{% endschema %}
