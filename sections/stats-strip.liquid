<style>
.un-stats {
  border-top: 1px solid rgba(240,235,224,0.08);
  border-bottom: 1px solid rgba(240,235,224,0.08);
  background: rgba(8,11,8,0.6);
  backdrop-filter: blur(6px);
}
.un-stats-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
}
.un-stat {
  padding: 52px 40px;
  border-right: 1px solid rgba(240,235,224,0.08);
  position: relative;
  transition: background 0.25s;
}
.un-stat:last-child { border-right: none; }
.un-stat:hover { background: rgba(212,168,71,0.04); }

.un-stat-num {
  font-family: 'Playfair Display', serif;
  font-size: 52px;
  font-weight: 900;
  color: var(--accent);
  display: block;
  line-height: 1;
  margin-bottom: 10px;
  letter-spacing: -1px;
}
.un-stat-label {
  font-size: 11px;
  color: rgba(240,235,224,0.35);
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 400;
  display: block;
}

@media (max-width: 900px) {
  .un-stats-inner {
    grid-template-columns: repeat(2, 1fr);
  }
  .un-stat:nth-child(2) { border-right: none; }
  .un-stat:nth-child(3) { border-top: 1px solid rgba(240,235,224,0.08); }
  .un-stat:nth-child(4) {
    border-top: 1px solid rgba(240,235,224,0.08);
    border-right: none;
  }
  .un-stat { padding: 36px 28px; }
  .un-stat-num { font-size: 40px; }
}
</style>

<div class="un-stats">
  <div class="un-stats-inner">
    {% for block in section.blocks %}
      <div class="un-stat" {{ block.shopify_attributes }}>
        <span class="un-stat-num">{{ block.settings.number }}</span>
        <span class="un-stat-label">{{ block.settings.label }}</span>
      </div>
    {% endfor %}
  </div>
</div>

{% schema %}
{
  "name": "Stats strip",
  "blocks": [
    {
      "type": "stat",
      "name": "Statistika",
      "settings": [
        { "type": "text", "id": "number", "label": "Číslo", "default": "12+" },
        { "type": "text", "id": "label", "label": "Popisek", "default": "Unikátních her" }
      ]
    }
  ],
  "presets": [{
    "name": "Stats strip",
    "blocks": [
      { "type": "stat", "settings": { "number": "12+", "label": "Unikátních her" } },
      { "type": "stat", "settings": { "number": "3 000+", "label": "Spokojených hráčů" } },
      { "type": "stat", "settings": { "number": "4.9", "label": "Průměrné hodnocení" } },
      { "type": "stat", "settings": { "number": "Online", "label": "i papírové verze" } }
    ]
  }]
}
{% endschema %}
