<style>
.un-reviews {
  padding: 100px 48px;
  background: rgba(8,11,8,0.55);
  border-top: 1px solid rgba(240,235,224,0.08);
}
.un-reviews-inner { max-width: 1100px; margin: 0 auto; }

.un-reviews-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 56px;
  flex-wrap: wrap;
  gap: 16px;
}

.un-reviews-score {
  text-align: right;
}
.un-reviews-score-num {
  font-family: 'Playfair Display', serif;
  font-size: 56px;
  font-weight: 900;
  color: var(--accent);
  line-height: 1;
  display: block;
  letter-spacing: -2px;
}
.un-reviews-score-label {
  font-size: 11px;
  color: rgba(240,235,224,0.3);
  letter-spacing: 2px;
  text-transform: uppercase;
  font-weight: 400;
}

.un-reviews-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 1px;
  background: rgba(240,235,224,0.08);
}

.un-review-card {
  background: rgba(8,11,8,0.55);
  padding: 40px 36px;
  display: flex;
  flex-direction: column;
  gap: 20px;
  position: relative;
  overflow: hidden;
  transition: background 0.25s;
}
.un-review-card:hover {
  background: rgba(8,11,8,0.95);
}

/* Velký uvozovací znak */
.un-review-quote-mark {
  font-family: 'Playfair Display', serif;
  font-size: 96px;
  line-height: 0.7;
  color: rgba(212,168,71,0.12);
  pointer-events: none;
  user-select: none;
  display: block;
  margin-bottom: -8px;
}

.un-stars {
  display: flex;
  gap: 3px;
}
.un-star {
  width: 12px;
  height: 12px;
  fill: var(--accent);
}

.un-review-text {
  font-size: 15px;
  color: rgba(240,235,224,0.65);
  line-height: 1.8;
  font-weight: 300;
  flex: 1;
  font-style: italic;
}

.un-review-author {
  font-size: 11px;
  color: rgba(240,235,224,0.3);
  font-weight: 500;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  display: flex;
  align-items: center;
  gap: 12px;
  padding-top: 16px;
  border-top: 1px solid rgba(240,235,224,0.06);
}
.un-review-author::before {
  content: '';
  display: block;
  width: 20px;
  height: 1px;
  background: var(--accent);
  opacity: 0.6;
  flex-shrink: 0;
}

@media (max-width: 900px) {
  .un-reviews { padding: 64px 24px; }
  .un-reviews-grid { grid-template-columns: 1fr; }
  .un-reviews-header { flex-direction: column; align-items: flex-start; }
  .un-reviews-score { text-align: left; }
  .un-review-card { padding: 32px 28px; }
}
</style>

<section class="un-reviews" id="recenze">
  <div class="un-reviews-inner">
    <div class="un-reviews-header">
      <div>
        <span class="section-label">{{ section.settings.label }}</span>
        <h2 class="section-title" style="margin-bottom:0;">{{ section.settings.title }}</h2>
      </div>
      <div class="un-reviews-score">
        <span class="un-reviews-score-num">{{ section.settings.count }}</span>
        <span class="un-reviews-score-label">spokojených hráčů</span>
      </div>
    </div>

    <div class="un-reviews-grid">
      {% for block in section.blocks %}
        <div class="un-review-card" {{ block.shopify_attributes }}>
          <span class="un-review-quote-mark">"</span>
          <div class="un-stars">
            <svg class="un-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="un-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="un-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="un-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
            <svg class="un-star" viewBox="0 0 24 24"><path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/></svg>
          </div>
          <p class="un-review-text">{{ block.settings.text }}</p>
          <div class="un-review-author">{{ block.settings.author }}</div>
        </div>
      {% endfor %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Recenze",
  "settings": [
    { "type": "text", "id": "label", "label": "Label", "default": "Sociální důkaz" },
    { "type": "text", "id": "title", "label": "Nadpis", "default": "Co říkají hráči" },
    { "type": "text", "id": "count", "label": "Počet hráčů", "default": "3 000+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recenze",
      "settings": [
        { "type": "textarea", "id": "text", "label": "Text recenze" },
        { "type": "text", "id": "author", "label": "Autor" }
      ]
    }
  ],
  "presets": [{
    "name": "Recenze",
    "blocks": [
      { "type": "review", "settings": { "text": "Naprosto skvělý zážitek! Strávili jsme s rodinou skoro 2 hodiny hledáním stop po celém centru.", "author": "Markéta H. · Děčín" } },
      { "type": "review", "settings": { "text": "Perfektní teambuilding. Kolektiv se skvěle sehrál, hry jsou vymyšlené s citem.", "author": "Tomáš B. · Praha" } },
      { "type": "review", "settings": { "text": "Papírovou verzi jsme hráli na chalupě — geniální nápad. Bavily se i děti.", "author": "Jana K. · Liberec" } }
    ]
  }]
}
{% endschema %}
